<!-- O Último Turno - Seleção de Detetive -->
<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>O Último Turno - Escolha seu Detetive</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&amp;family=Playfair+Display:ital,wght@0,700;0,900;1,700&amp;display=swap" rel="stylesheet">
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
  }

  body {
    width: 100vw;
    height: 100vh;
    background-color: #170b09;
    color: #F0EADF;
    font-family: 'Courier Prime', monospace;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 16:9 Game Screen Container (1920x1080 scaled) */
  .game-canvas {
    position: relative;
    width: 1920px;
    height: 1080px;
    background-color: #2B2B28;
    background-image:
      radial-gradient(ellipse at 50% 30%, rgba(58, 57, 52, 0.45) 0%, rgba(27, 27, 24, 0.95) 75%),
      repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0, 0, 0, 0.25) 4px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Vignette & Atmospheric Film Grain */
  .vignette-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 45%, rgba(15, 15, 13, 0.85) 100%);
    box-shadow: inset 0 0 160px rgba(0, 0, 0, 0.9);
    z-index: 20;
  }

  .film-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.08;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    z-index: 21;
  }

  /* Industrial desk background texture elements */
  .desk-texture {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(30, 29, 26, 0.6) 0%, transparent 20%, transparent 80%, rgba(30, 29, 26, 0.6) 100%),
      linear-gradient(0deg, #1B1B18 0%, transparent 35%);
    pointer-events: none;
    z-index: 1;
  }

  /* Top Header / Title */
  .header-container {
    position: relative;
    z-index: 10;
    margin-top: 64px;
    text-align: center;
  }

  .case-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: #8A8175;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .case-tag::before,
  .case-tag::after {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background-color: #C23B22;
  }

  .main-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #F0EADF;
    text-transform: uppercase;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.7);
  }

  .sub-tagline {
    font-size: 15px;
    letter-spacing: 0.12em;
    color: #8A8175;
    margin-top: 6px;
  }

  /* Dossier Cards Arena */
  .cards-arena {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 96px;
    margin-top: 42px;
  }

  /* Cream Paper Dossier Card */
  .dossier-card {
    position: relative;
    width: 520px;
    height: 680px;
    background-color: #D8CFBC;
    color: #1B1B18;
    border: 1px solid #8A8175;
    border-radius: 3px;
    padding: 34px 38px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.65),
      0 3px 8px rgba(0, 0, 0, 0.45);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.18s ease;
  }

  /* Aged paper subtle border and stamp grain */
  .dossier-card::before {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(138, 129, 117, 0.4);
    pointer-events: none;
    border-radius: 2px;
  }

  /* Top Right Folder Clip / Notch detail */
  .dossier-card::after {
    content: "";
    position: absolute;
    top: 0;
    right: 48px;
    width: 36px;
    height: 12px;
    background: #8A8175;
    opacity: 0.35;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    pointer-events: none;
  }

  .dossier-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 26px 55px rgba(0, 0, 0, 0.75),
      0 6px 14px rgba(0, 0, 0, 0.5);
    border-color: #A8321D;
  }

  /* Active/Selected Dossier State */
  .dossier-card.selected {
    transform: translateY(-6px);
    border: 2px solid #C23B22;
    box-shadow:
      0 30px 65px rgba(0, 0, 0, 0.8),
      0 0 0 1px #C23B22,
      0 4px 16px rgba(194, 59, 34, 0.25);
  }

  .dossier-card.selected::before {
    border-color: rgba(194, 59, 34, 0.4);
  }

  /* Card Header: Tab + File Code */
  .card-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(138, 129, 117, 0.55);
    padding-bottom: 12px;
    margin-bottom: 18px;
  }

  .file-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #1B1B18;
    color: #F0EADF;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 4px 10px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .dossier-card.selected .file-tab {
    background: #C23B22;
