  let selected = null;

  function selectDetective(id) {
    selected = id;
    const cardMarple = document.getElementById('card-marple');
    const cardPoirot = document.getElementById('card-poirot');
    const btn = document.getElementById('btn-start');
    const hint = document.getElementById('status-hint');

    if (id === 'marple') {
      cardMarple.classList.add('selected');
      cardPoirot.classList.remove('selected');
      hint.innerText = '[ Detetive selecionada: Miss Marple • Pressione para iniciar ]';
    } else if (id === 'poirot') {
      cardPoirot.classList.add('selected');
      cardMarple.classList.remove('selected');
      hint.innerText = '[ Detetive selecionado: Hercule Poirot • Pressione para iniciar ]';
    }

    btn.disabled = false;
    btn.classList.add('enabled');
  }

  // Pre-select Miss Marple by default to showcase the active state immediately
  window.addEventListener('DOMContentLoaded', () => {
    selectDetective('marple');
  });

  function startInvestigation() {
    if (!selected) return;
    const name = selected === 'marple' ? 'Miss Marple' : 'Hercule Poirot';
    console.log('Iniciando investigação com:', name);
  }
</script>






